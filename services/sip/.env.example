VOCIVO_SIP_REALM=sip.vocivo.app
VOCIVO_SIP_DOMAIN=sip.vocivo.app
VOCIVO_SIP_WSS_URI=wss://sip.vocivo.app/ws
VOCIVO_API_URL=https://vocivo.app
SIP_EDGE_SECRET=replace-with-a-long-shared-secret
TELNYX_SIP_HOST=sip.telnyx.com
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
TELNYX_SIP_REALM=sip.telnyx.com
PUBLIC_IP=127.0.0.1
# rtpengine's media ports: four per call. Keep clear of FreeSWITCH's 20000-24999.
RTP_START=30000
RTP_END=39999
VOCIVO_SIP_INBOUND=0
# Generate securely on the server; never commit the actual value.
TURN_SECRET=
TURN_RELAY_MIN_PORT=49152
TURN_RELAY_MAX_PORT=65535
# API/Vercel environment (not the coturn container): use the identical secret.
VOCIVO_TURN_SECRET=
VOCIVO_TURN_URLS=turn:sip.vocivo.app:3478?transport=udp,turn:sip.vocivo.app:3478?transport=tcp

# API-side setting: managed-provider sources only. BYOC/Go uses tenant deployment
# records. Leave empty when no managed-provider numbers are in use.
# VOCIVO_MANAGED_TRUNK_SOURCES=
